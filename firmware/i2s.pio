;
; Standard Philips I2S: stereo 16-bit, MSB first, one-bit WS delay.
; side-set bit 0 = BCLK, bit 1 = LRCLK. 64 PIO cycles per stereo frame.
; FIFO word: two duplicated mono samples, bits 31:16 followed by bits 15:0.
.program robot_i2s
.side_set 2
bitloop1:
    out pins, 1     side 0b10
    jmp x-- bitloop1 side 0b11
    out pins, 1     side 0b00
    set x, 14       side 0b01
bitloop0:
    out pins, 1     side 0b00
    jmp x-- bitloop0 side 0b01
    out pins, 1     side 0b10
public entry_point:
    set x, 14       side 0b11
